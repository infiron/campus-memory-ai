# Local development defaults; never commit real secrets.
APP_ENV=development
APP_SCHOOL_NAME=示范学校（演示环境）
SEED_DEMO_DATA=true
DATABASE_URL=sqlite:///./campus_memory.db
SECRET_KEY=replace-this-with-a-long-random-secret-before-deploying
TOKEN_TTL_HOURS=12
# Optional OpenAI-compatible service; leave blank to use rule-based and evidence-template fallback.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_TIMEOUT_SECONDS=20
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
